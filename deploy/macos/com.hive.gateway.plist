<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hive.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HIVE_DIR__/.venv/bin/python</string>
    <string>-m</string>
    <string>hive.gateway</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HIVE_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HIVE_GATEWAY_PORT</key>
    <string>8480</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/hive-gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/hive-gateway.log</string>
</dict>
</plist>
