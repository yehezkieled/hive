# Telegram bot (Wonder bot — get token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot
TELEGRAM_ALLOWED_USER_IDS=

# Hive defaults
HIVE_DEFAULT_MODEL=sonnet
HIVE_MAX_SESSIONS=3
HIVE_DEFAULT_MAESTRO=otter
# Claude Code binary the fleet spawns (Ticket 009). Unset = bare "claude" PATH
# lookup. Point at the native self-updating symlink so the fleet tracks the
# version dev tests against — see DEPLOYMENT.md "Claude Code version policy".
# HIVE_CLAUDE_BINARY=/home/hezki/.local/bin/claude
# Harness selection (ADR 0029): which agent harness runs turns, and in which mode.
# Pi first; headless by default, Claude's interactive PTY as the fallback.
# HIVE_HARNESS_ORDER=pi,claude
# Per-role override; maestro and vault (Claude-only guardrails) default to claude,pi.
# HIVE_HARNESS_ORDER_MAESTRO=claude,pi
# HIVE_RUN_MODE_ORDER=headless,pty
# HIVE_PI_BINARY=pi
# HIVE_PI_PROVIDER=
# HIVE_PI_MODEL=

# PostgreSQL (Sprint 2a+) — see docker-compose.yml
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=

# Auto-management (Sprint 10)
HIVE_AUTO_COMPACT_ENABLED=true
HIVE_AUTO_COMPACT_THRESHOLD=50000
HIVE_AUTO_KILL_IDLE_ENABLED=true
HIVE_IDLE_TIMEOUT_MINUTES=30
HIVE_DAILY_SUMMARY_ENABLED=true
HIVE_DAILY_SUMMARY_HOUR=23
# Telegram chat ID for proactive notifications (daily summary, auto-compact alerts)
HIVE_SUMMARY_CHAT_ID=

# Backups (Sprint 29) — where the daily pg_dump systemd timer writes
# gzipped SQL dumps. Defaults to ~/backups/hive when unset.
# HIVE_BACKUP_DIR=/home/hezki/backups/hive
